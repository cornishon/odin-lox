package olox

Opcode :: enum u8 {
	NIL,
	FALSE,
	TRUE,
	POP,
	RETURN,
	CONST,
	PRINT,
	GET_LOCAL,
	SET_LOCAL,
	DEF_GLOBAL,
	GET_GLOBAL,
	SET_GLOBAL,
	GET_UPVALUE,
	SET_UPVALUE,
	GET_PROPERTY,
	SET_PROPERTY,
	GET_SUPER,
	LOOP,
	CALL,
	INVOKE,
	SUPER_INVOKE,
	CLOSURE,
	CLOSE_UPVALUE,
	JUMP,
	JUMP_IF_NOT,
	EQUAL,
	LESS,
	GREATER,
	ADD,
	SUB,
	MUL,
	DIV,
	NOT,
	NEGATE,
	CLASS,
	METHOD,
	INHERIT,
	ARRAY,
	SET_ARRAY,
	GET_ARRAY,
}
